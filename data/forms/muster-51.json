 "muster": "51",
 "title": "Anfrage zur Zuständigkeit eines sonstigen Kostenträgers",
 "form_version": "10.2005",
 "released": "2005-08-08",
 "status": "entwurf",
 "paper": {
  "format": "DIN A4 hoch, Vorder- und Rückseite",
  "width": 595.3,
  "height": 841.9,
  "tint": "ohne"
 },
 "pages": [
  "Vorderseite (Anfrage der Krankenkasse)",
  "Rückseite (Antwort des Vertragsarztes)"
 ],
 "copies": [
  {
   "id": "51",
   "label": "Anfrage mit Antwortseite",
   "recipient": "Krankenkasse (Rücksendung im Freiumschlag)"
  }
 ],
 "notes": [
  {
   "id": "m51.zweck",
   "text": "In unklaren Fällen wird geklärt, ob die Krankenkasse oder ein sonstiger Kostenträger für Kosten verordneter Leistungen bzw. der Behandlung zuständig ist, um ggf. Schadensersatz geltend zu machen.",
   "source": {
    "artifact": "erlaeuterungen",
    "locator": "Muster 51, Nr. 1, S. 87"
   }
  },
  {
   "id": "m51.ausfuellen",
   "text": "Die Krankenkasse sendet den Vordruck mit Sachverhalt an den Arzt, der anhand seiner Kartei antwortet. Ist Sachverhalt 1 (Arbeitsunfall, sonstiger Unfall) zu beurteilen, nur Angaben zu 1 ausfüllen; zu 2 nur, wenn die Kasse dazu Auskunft verlangt.",
   "source": {
    "artifact": "erlaeuterungen",
    "locator": "Muster 51, Nr. 2, S. 87"
   }
  },
  {
   "id": "m51.vorderseite",
   "text": "Die Vorderseite füllt die Krankenkasse aus: Anrede, Datum der Bescheinigung/Verordnung, Name, Geburtsdatum, Anschrift, Versichertennummer, Art der ausgestellten Unterlage (Arbeitsunfähigkeitsbescheinigung, Verordnung(en), Verordnung von Krankenhausbehandlung) und der Sachverhalt 1. (Arbeitsunfall, auch Wege-/Berufskrankheit, oder sonstiger Unfall bzw. Gewalteinwirkung) und/oder 2. (möglicher Zusammenhang mit anerkannten Versorgungsleiden). Der Arzt füllt nur die Rückseite („Vom Vertragsarzt auszufüllen!“) aus.",
   "source": {
    "artifact": "mustersammlung",
    "locator": "PDF-Seite 60, Muster 51 (10.2005)"
   }
  },
  {
   "id": "m51.ebm_01622",
   "text": "Für die Beantwortung dieser Anfrage ist die Nr. 01622 EBM berechnungsfähig (Aufdruck).",
   "source": {
    "artifact": "mustersammlung",
    "locator": "PDF-Seite 60, Muster 51 (10.2005)"
   }
  }
 ],
