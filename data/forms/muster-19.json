 "notes": [
  {
   "id": "m19.teil_a_schwaerzung",
   "text": "Teil a (Abrechnung bei der KV) ist aus Datenschutzgründen teilweise geschwärzt; diese Teile sind nach Hochklappen des ersten Blattes ab Blatt 2 auszufüllen. Beim EDV-Ausdruck erfolgt die Beschriftung ab Blatt 1 im geschwärzten Feld.",
   "source": {
    "artifact": "erlaeuterungen",
    "locator": "Muster 19, Nr. 1, S. 63"
   }
  },
  {
   "id": "m19.teil_b",
   "text": "Muster 19b ist vom behandelnden Arzt zu unterschreiben und dem weiterbehandelnden Arzt als Mitteilung zuzustellen. Die weitere Durchschrift (19c) verbleibt beim vertretenden Arzt.",
   "source": {
    "artifact": "erlaeuterungen",
    "locator": "Muster 19, Nr. 2, S. 63"
   }
  },
  {
   "id": "m19.teil_b_entfaellt",
   "text": "Muster 19b kann entfallen, wenn keine Informationsübermittlung an einen weiterbehandelnden Arzt nötig ist oder diese auf geeignete Weise, z. B. per Arztbrief, erfolgt.",
   "source": {
    "artifact": "erlaeuterungen",
    "locator": "Muster 19, Nr. 4, S. 63"
   }
  },
  {
   "id": "m19.arbeitsunfall",
   "text": "Nicht zu verwenden bei Arbeitsunfällen, Berufskrankheiten und Schülerunfällen.",
   "source": {
    "artifact": "mustersammlung",
    "locator": "PDF-Seite 33, Muster 19a (10.2014)"
   }
  }
 ],
