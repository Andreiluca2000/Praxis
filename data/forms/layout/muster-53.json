alse, "dark": true, "white": false}, {"t": "Von der Krankenkasse auszufüllen!", "x": 39.88, "y": 58.17, "s": 12.0, "b": true, "i": false, "ghost": false, "dark": true, "white": false}, {"t": "Vom Vertragsarzt auszufüllen!", "x": 39.88, "y": 340.17, "s": 12.0, "b": true, "i": false, "ghost": false, "dark": true, "white": false}, {"t": "I.", "x": 25.48, "y": 84.17, "s": 9.0, "b": false, "i": false, "ghost": false, "dark": true, "white": false}, {"t": "Arbeitsunfähig vom", "x": 39.88, "y": 84.17, "s": 9.0, "b": false, "i": false, "ghost": false, "dark": true, "white": false}, {"t": "bis", "x": 214.12, "y": 84.17, "s": 9.0, "b": false, "i": false, "ghost": false, "dark": true, "white": false}, {"t": "wegen", "x": 39.88, "y": 99.17, "s": 9.0, "b": false, "i": false, "ghost": false, "dark": true, "white": false}, {"t": "II.", "x": 25.48, "y": 171.17, "s": 9.0, "b": false, "i": false, "ghost": false, "dark": true, "white": false}, {"t": "Vorher bestand Arbeitsunfähigkeit wegen", "x": 39.88, "y": 171.17, "s": 9.0, "b": false, "i": false, "ghost": false, "dark": true, "white": false}, {"t": "Handelt es sich bei der unter I. angegebenen Krankheit und einer der unter II. genannten Krankheiten um", "x": 39.88, "y": 363.17, "s": 9.0, "b": false, "i": false, "ghost": false, "dark": true, "white": false}, {"t": "dieselbe Krankheit* im Sinne der unten abgedruckten versicherungsrechtlichen Erläuterungen?", "x": 39.88, "y": 375.17, "s": 9.0, "b": false, "i": false, "ghost": false, "dark": true, "white": false}, {"t": "nein", "x": 61.48, "y": 396.17, "s": 9.0, "b": false, "i": false, "ghost": false, "dark": true, "white": false}, {"t": "ja, und zwar bei der/den unter Ziffer(n)", "x": 122.69, "y": 396.17, "s": 9.0, "b": false, "i": false, "ghost": false, "dark": true, "white": false}, {"t": "genannten Krankheit(en).", "x": 435.91, "y": 396.17, "s": 9.0, "b": false, "i": false, "ghost": false, "dark": true, "white": false}, {"t": "Handelt es sich bei der hinzugetretenen Krankheit und einer unter II. genannten früheren Erkrankung um", "x": 39.88, "y": 567.17, "s": 9.0, "b": false, "i": false, "ghost": false, "dark": true, "white": false}, {"t": "dieselbe Krankheit* im Sinne der unten abgedruckten versicherungsrechtlichen Erläuterungen?", "x": 39.88, "y": 579.17, "s": 9.0, "b": false, "i": false, "ghost": false, "dark": true, "white": false}, {"t": "*) Versicherungsrechtliche Erläuterungen", "x": 39.89, "y": 771.17, "s": 9.0, "b": true, "i": false, "ghost": false, "dark": true, "white": false}, {"t": "Der Begriff “dieselbe Krankheit” setzt nicht vorraus, dass fortlaufende Behandlungsbedürftigkeit besteht. Bei wiederholter Arbeits-", "x": 39.89, "y": 783.17, "s": 9.0, "b": false, "i": false, "ghost": false, "dark": true, "white": false}, {"t": "unfähigkeit kommt es darauf an, ob die neue Arbeitsunfähigkeit und die frühere(n) auf derselben Krankheitsursache beruhen oder", "x": 39.89, "y": 795.17, "s": 9.0, "b": false, "i": false, "ghost": false, "dark": true, "white": false}, {"t": "zumindest in einem inneren Zusammenhang mit ihr stehen. Der innere Zusammenhang kann schon dadurch begründet sein, dass", "x": 39.89, "y": 807.17, "s": 9.0, "b": false, "i": false, "ghost": false, "dark": true, "white": false}, {"t": "die Entstehung der Krankheit jedesmal durch eine gemeinsame Bedingung begünstigt oder herbeigeführt wird.", "x": 39.89, "y": 819.17, "s": 9.0, "b": false, "i": false, "ghost": false, "dark": true, "white": false}, {"t": "nein", "x": 61.48, "y": 600.17, "s": 9.0, "b": false, "i": false, "ghost": false, "dark": true, "white": false}, {"t": "ja, und zwar bei der/den unter Ziffer(n)", "x": 122.69, "y": 600.17, "s": 9.0, "b": false, "i": false, "ghost": false, "dark": true, "white": false}, {"t": "genannten Krankheit(en).", "x": 435.9, "y": 600.17, "s": 9.0, "b": false, "i": false, "ghost": false, "dark": true, "white": false}, {"t": "III.", "x": 25.48, "y": 423.17, "s": 9.0, "b": false, "i": false, "ghost": false, "dark": true, "white": false}, {