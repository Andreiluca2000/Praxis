 ],
 "copies": [
  {
   "id": "64a",
   "label": "Ausfertigung für die Krankenkasse",
   "recipient": "Krankenkasse"
  },
  {
   "id": "64b",
   "label": "Ausfertigung",
   "recipient": "Versicherte/r bzw. Praxis"
  }
 ],
 "notes": [
  {
   "id": "m64.vorhalten",
   "text": "Das Muster wird in der Vertragsarztpraxis vorgehalten. Für die Empfehlung einer Mutter-/Vater-Kind-Leistung ist die Indikation der Mutter bzw. des Vaters maßgebend.",
   "source": {
    "artifact": "erlaeuterungen",
    "locator": "Muster 64, Einleitung, S. 133"
   }
  },
  {
   "id": "m64.abgrenzung",
   "text": "Leistungen zur medizinischen Rehabilitation für Mütter und Väter werden auf Muster 61 verordnet; bei der Vorsorge liegen noch keine längerfristigen (über 6 Monate) Aktivitätsbeeinträchtigungen vor.",
   "source": {
    "artifact": "erlaeuterungen",
    "locator": "Muster 64, Einleitung, S. 133"
   }
  },
  {
   "id": "m64.belastbarkeit",
   "text": "Die Krankenkasse erbringt Vorsorgeleistungen nur, wenn eine ausreichende physische und psychische Belastbarkeit für die Leistung gegeben ist.",
   "source": {
    "artifact": "erlaeuterungen",
    "locator": "Muster 64, Einleitung, S. 133"
   }
  },
  {
   "id": "m64.vorsorgebeduerftigkeit",
   "text": "Vorsorgebedürftigkeit besteht bei beeinflussbaren Risikofaktoren oder Gesundheitsstörungen, die absehbar zu Krankheit führen, oder bei manifester Krankheit zur Verhinderung drohender Beeinträchtigungen bzw. von Rezidiven; nur wenn über die kurative Versorgung hinaus der komplexe Ansatz erforderlich ist.",
   "source": {
    "artifact": "erlaeuterungen",
    "locator": "Muster 64, II. Vorsorgebedürftigkeit, S. 133–134"
   }
  },
  {
   "id": "m64.ebm",
   "text": "Für das Ausstellen der ärztlichen Verordnung ist die Nr. 01624 EBM berechnungsfähig (Aufdruck).",
   "source": {
    "artifact": "mustersammlung",
    "locator": "PDF-Seite 96, Muster 64 Ba (10.2018)"
   }
  }
 ],
 "groups": [
  {
   "id": "kontext",
   "label": "II. C. Kontextfaktoren",
   "select": "beliebig",
   "rule": {
    "id": "m64.kontextfaktoren",
    "text": "Kontextfaktoren (Umwelt- und personbezogene Einflüsse, z. B. ständiger Zeitdruck, finanzielle Sorgen) angeben, die bei Müttern/Vätern aufgrund der Erziehungsverantwortung eine besondere Belastung bilden können.",
    "source": {
     "artifact": "erlaeuterungen",
     "locator": "Muster 64, ❹, S. 135"
    }
   }
  },
  {
   "id": "leistungsform",
   "label": "V. A. Empfohlene Leistungsform",
   "select": "genau_eins",
   "rule": {
    "id": "m64.leistungsform",
    "text": "Leistungsform empfehlen (Mütter-/Väter-Leistung oder gemeinsame Mutter-/Vater-Kind-Leistung). Eine gemeinsame Leistung kommt bei eigener Vorsorgebedürftigkeit in Betracht, nicht aber bei eigener Reha-Indikation des Kindes.",
    "source": {
     "artifact": "erlaeuterungen",
     "locator": "Muster 64, ❼, S. 137"
    }
   }
  }
 ],
