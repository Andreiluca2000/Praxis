 "muster": "64",
 "title": "Verordnung medizinischer Vorsorge für Mütter oder Väter gemäß § 24 SGB V",
 "form_version": "10.2018",
 "released": "2018-03-29",
 "status": "entwurf",
 "paper": {
  "format": "DIN A4 hoch",
