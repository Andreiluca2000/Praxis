 ],
 "notes": [
  {
   "id": "m50.anlass",
   "text": "Die Krankenkassen benötigen die Anfrage, wenn sie aus vorliegenden ärztlichen Bescheinigungen, z. B. wegen unvollständiger oder fehlerhafter Angaben im Personalienfeld, eine Mitgliedschaft nicht feststellen können.",
   "source": {
    "artifact": "erlaeuterungen",
    "locator": "Muster 50, Nr. 1, S. 86"
   }
  },
  {
   "id": "m50.vorderseite",
   "text": "Die Vorderseite füllt die Krankenkasse aus: Anrede, Datum der Bescheinigung/Verordnung, Name, Geburtsdatum, Anschrift und Versichertennummer, Art der ausgestellten Unterlage (Arbeitsunfähigkeitsbescheinigung, Verordnung(en), Verordnung von Krankenhausbehandlung) und Ende der Mitgliedschaft. Der Arzt füllt nur die Rückseite („Vom Vertragsarzt auszufüllen!“) aus.",
   "source": {
    "artifact": "mustersammlung",
    "locator": "PDF-Seite 58, Muster 50 (10.2005)"
   }
  },
  {
   "id": "m50.ebm_01620",
   "text": "Für die Beantwortung dieser Anfrage ist die Nr. 01620 EBM berechnungsfähig (Aufdruck).",
   "source": {
    "artifact": "mustersammlung",
    "locator": "PDF-Seite 58, Muster 50 (10.2005)"
   }
  }
 ],
 "groups": [
  {
   "id": "name_richtig",
   "label": "Name und Geburtsdatum richtig wiedergegeben?",
   "select": "genau_eins",
   "rule": {
    "id": "m50.frage_name",
    "text": "Frage der Krankenkasse: „Wurde der Name und das Geburtsdatum von uns richtig wiedergegeben?“ – ja oder nein; bei nein berichtigen.",
