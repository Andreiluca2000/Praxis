 "notes": [
  {
   "id": "m62b.potenzialerhebung",
   "text": "Bei beatmeten und trachealkanülierten Versicherten ist die Verordnung grundsätzlich nur möglich, wenn eine aktuelle Potenzialerhebung (Muster 62A) vorliegt, die bei Verordnung nicht älter als 3 Monate ist.",
   "source": {
    "artifact": "erlaeuterungen",
    "locator": "Muster 62B, Einleitung, S. 123"
   }
  },
  {
   "id": "m62b.folgeverordnung_dauer",
   "text": "Folgeverordnungen dürfen längstens für sechs Monate ausgestellt werden. Erhebungen sind alle 6 Monate nötig, bei dauerhaft fehlendem Potenzial alle 12 Monate; nach zweimal in Folge persönlich festgestelltem fehlendem Potenzial in mindestens zwei Jahren kann die Erhebung entfallen.",
   "source": {
    "artifact": "erlaeuterungen",
    "locator": "Muster 62B, Einleitung, S. 123"
   }
  },
  {
   "id": "m62b.exemplare",
   "text": "Exemplare erhalten die verordnende Ärztin/der verordnende Arzt, der Leistungserbringer nach § 132l Abs. 5 SGB V und die Krankenkasse.",
   "source": {
    "artifact": "erlaeuterungen",
    "locator": "Muster 62B, Einleitung, S. 123"
   }
  }
 ],
