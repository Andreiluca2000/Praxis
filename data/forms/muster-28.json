 "muster": "28",
 "title": "Verordnung bei Überweisung zur Indikationsstellung für Soziotherapie gemäß § 37a SGB V im Umfang von maximal 5 Therapieeinheiten",
 "form_version": "10.2017",
 "released": "2017-07-07",
 "status": "entwurf",
 "paper": {
  "format": "DIN A4 hoch",
  "width": 595.3,
  "height": 841.9,
  "tint": "blau"
 },
 "copies": [
  {
   "id": "28a",
   "label": "Ausfertigung für die Krankenkasse (Original)",
   "recipient": "Krankenkasse (vom soziotherapeutischen Leistungserbringer weiterzuleiten)"
  },
  {
   "id": "28b",
   "label": "Ausfertigung für den soziotherapeutischen Leistungserbringer (1. Durchschlag)",
   "recipient": "soziotherapeutischer Leistungserbringer"
  },
  {
   "id": "28c",
   "label": "Ausfertigung für den verordnenden Arzt (2. Durchschlag)",
   "recipient": "verbleibt in der Praxis"
  }
 ],
 "notes": [
  {
   "id": "m28.voraussetzung",
   "text": "Andere als die nach ST-RL berechtigten Ärzte können mit Muster 28 zu einem verordnungsberechtigten Facharzt bzw. Psychotherapeuten überweisen, wenn sie begründeten Verdacht auf eine Soziotherapie-Indikation haben.",
   "source": {
    "artifact": "erlaeuterungen",
    "locator": "Muster 28, Einleitung, S. 77"
   }
  },
  {
   "id": "m28.st_rl_durchschlaege",
   "text": "Die Soziotherapie-Richtlinie (ST-RL) ist zu beachten; zwei Durchschläge: Original Krankenkasse, 1. Durchschlag soziotherapeutischer Leistungserbringer, 2. Durchschlag Arzt.",
   "source": {
    "artifact": "erlaeuterungen",
    "locator": "Muster 28, Einleitung, S. 77"
   }
  },
  {
   "id": "m28.keine_genehmigung",
   "text": "Verordnungen auf Muster 28 bedürfen nicht der Genehmigung durch die Krankenkasse des Patienten.",
   "source": {
    "artifact": "erlaeuterungen",
    "locator": "Muster 28, ❻, S. 79"
   }
  },
  {
   "id": "m28.ebm_30800",
   "text": "Für das Ausstellen dieses Vordrucks ist die Nr. 30800 EBM berechnungsfähig (Hinweis auf dem Vordruck).",
   "source": {
    "artifact": "mustersammlung",
    "locator": "PDF-Seite 52, Muster 28a (10.2017)"
   }
  },
  {
   "id": "m28.le_erklaerung",
   "text": "Der soziotherapeutische Leistungserbringer erklärt auf dem Vordruck, dass er einen Vertrag gem. § 132b SGB V geschlossen hat oder eine vergleichbare Abrechnungsgenehmigung der zuständigen Krankenkasse vorliegt.",
   "source": {
    "artifact": "mustersammlung",
    "locator": "PDF-Seite 52, Muster 28a (10.2017)"
   }
  },
  {
   "id": "m28.weiterleitung",
   "text": "Die Ausfertigung für die Krankenkasse ist vom soziotherapeutischen Leistungserbringer an die Krankenkasse weiterzuleiten (Hinweis auf dem Vordruck).",
   "source": {
    "artifact": "mustersammlung",
    "locator": "PDF-Seite 52, Muster 28a (10.2017)"
   }
  }
 ],
