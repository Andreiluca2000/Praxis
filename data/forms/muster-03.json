 "notes": [
  {
   "id": "m03.untersuchung",
   "text": "Das Zeugnis darf nur aufgrund einer ärztlichen Untersuchung der Schwangeren ausgestellt werden.",
   "source": {
    "artifact": "erlaeuterungen",
    "locator": "Muster 3, Nr. 1, S. 16"
   }
  },
  {
   "id": "m03.daten",
   "text": "Wichtig sind zwei Daten: Ausstellungsdatum und Untersuchungsdatum. Das Mutterschaftsgeld wird vor der Entbindung nur aufgrund dieses Zeugnisses gezahlt, das bei Feststellung der Schwangerschaft ausgestellt werden soll.",
   "source": {
    "artifact": "erlaeuterungen",
    "locator": "Muster 3, Nr. 2, S. 16"
   }
  },
  {
   "id": "m03.dokumentation",
   "text": "Für spätere Streitfälle bei erheblicher Abweichung vom tatsächlichen Termin empfiehlt sich, in der Kartei Zeitpunkt der letzten Periode, erste Kindsbewegung und Stand des Fundus uteri festzuhalten.",
   "source": {
    "artifact": "erlaeuterungen",
    "locator": "Muster 3, Nr. 3, S. 16"
   }
  },
  {
   "id": "m03.abgegolten",
   "text": "Die Ausstellung ist mit der im zeitlichen Zusammenhang durchgeführten Vorsorgeuntersuchung abgegolten. Sucht die Schwangere den Arzt deshalb besonders auf, kann eine Beratung berechnet werden.",
   "source": {
    "artifact": "erlaeuterungen",
    "locator": "Muster 3, Nr. 4, S. 16"
   }
  },
  {
   "id": "m03.ausfertigung_3b",
   "text": "Muster 3b hat keine Rückseite; die Zeile „voraussichtlich entbinden wird am“ trägt dort keine Beschriftung (Datumsfeld T T M M J J ist vorhanden).",
   "source": {
    "artifact": "mustersammlung",
    "locator": "PDF-Seite 7, Muster 3 (10.2014)"
   }
  }
 ],
