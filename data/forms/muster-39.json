 "notes": [
  {
   "id": "m39.zweck",
   "text": "Der Vordruck dient der Beauftragung von Primärscreening oder Abklärungsdiagnostik und der Übermittlung der Befunde; die Angaben folgen den Dokumentationsvorgaben der oKFE-Richtlinie des G-BA.",
   "source": {
    "artifact": "erlaeuterungen",
    "locator": "Muster 39, Einleitung, S. 83"
   }
  },
  {
   "id": "m39.arbeitsteilung",
   "text": "Der Gynäkologe füllt den linken Bereich (❶–❻) aus und sendet das Formular mit der Probe an den Zytologen, der rechts Ergebnisse und Empfehlung ergänzt. Muster 39a geht an den Gynäkologen zurück, 39b verbleibt beim Zytologen.",
   "source": {
    "artifact": "erlaeuterungen",
    "locator": "Muster 39, Einleitung, S. 83"
   }
  },
  {
   "id": "m39.digital",
   "text": "Muster 39 kann auch digital genutzt werden (Anlage 2b BMV-Ä). Die Rückmeldung kann in Abstimmung beider Parteien digital erfolgen (z. B. eArztbrief), auch wenn die Beauftragung in Papierform erfolgte.",
   "source": {
    "artifact": "erlaeuterungen",
    "locator": "Muster 39, Einleitung, S. 83"
   }
  },
  {
   "id": "m39.behandlungstag",
   "text": "Für die Definition des Behandlungstages gelten die Bestimmungen des EBM (Ziffer I, Abschnitt 3.8.5).",
   "source": {
    "artifact": "erlaeuterungen",
    "locator": "Muster 39, Einleitung, S. 83"
   }
  }
 ],
 "groups": [
