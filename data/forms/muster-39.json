   "id": "39a",
   "label": "Ausfertigung für den untersuchenden Arzt",
   "recipient": "untersuchender Arzt (kommt mit dem Befund vom Zytologen zurück)"
  },
  {
   "id": "39b",
   "label": "Ausfertigung für den zytologisch tätigen Arzt",
   "recipient": "verbleibt beim zytologisch tätigen Arzt"
  }
