  {
   "id": "auftrag",
   "label": "Auftrag (Primärscreening / Abklärungsdiagnostik; Zytologie / HPV-Test / Ko-Testung)",
   "select": "beliebig",
   "rule": {
    "id": "m39.auftrag",
    "text": "Differenzierte Beauftragung von Primärscreening oder Abklärung. Wird der HPV-Test selbst erbracht oder an Dritte überwiesen, ist das im Freitextfeld 6 anzuzeigen und der Befund zugänglich zu machen; bei aufgespaltener Ko-Testung wird nur Zytologie angekreuzt.",
    "source": {
     "artifact": "erlaeuterungen",
     "locator": "Muster 39, ❷, S. 83–84"
    }
   }
  },
  {
   "id": "vorunters",
   "label": "Wurde bereits eine Krebsfrüherkennungsuntersuchung durchgeführt?",
   "select": "beliebig",
   "rule": {
    "id": "m39.anamnese",
    "text": "Erfasst werden Vorbefunde zu Screening und HPV-Status (Jahr eines früheren HPV-Tests ggf. als Anmerkung in Feld 6) sowie Voroperationen, Strahlen- oder Chemotherapie. Der zytologische Vorbefund wird nach den Schlüsseln der München-III-Klassifikation eingetragen.",
    "source": {
     "artifact": "erlaeuterungen",
     "locator": "Muster 39, ❸, S. 84"
    }
   }
