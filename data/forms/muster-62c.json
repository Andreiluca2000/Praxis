 "notes": [
  {
   "id": "m62c.beilage",
   "text": "Der Behandlungsplan wird der Verordnung beigelegt und von der verordnenden Vertragsärztin/dem verordnenden Vertragsarzt erstellt, ggf. unter Mitwirkung der potenzialerhebenden Ärztin/des Arztes; er soll die Informationsweitergabe zwischen den Beteiligten unterstützen.",
   "source": {
    "artifact": "erlaeuterungen",
    "locator": "Muster 62C, Einleitung, S. 128"
   }
  },
  {
   "id": "m62c.aktualisierung",
   "text": "Bei erforderlichen Änderungen von Therapiezielen, AKI-Maßnahmen oder Behandlungspflege wird der Plan aktualisiert; weicht der Inhalt oder Umfang der AKI von der Verordnung nach 62B ab, wird er der Krankenkasse erneut vorgelegt.",
   "source": {
    "artifact": "erlaeuterungen",
    "locator": "Muster 62C, Einleitung, S. 128"
   }
  },
  {
   "id": "m62c.exemplare",
   "text": "Exemplare erhalten die verordnende Ärztin/der verordnende Arzt, der Leistungserbringer nach § 132l Abs. 5 SGB V und die Krankenkasse.",
   "source": {
    "artifact": "erlaeuterungen",
    "locator": "Muster 62C, Einleitung, S. 128"
   }
  }
 ],
