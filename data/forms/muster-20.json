 "notes": [
  {
   "id": "m20.au_besteht",
   "text": "Auch während der stufenweisen Wiedereingliederung besteht Arbeitsunfähigkeit; die Fortdauer wird weiterhin auf der AU-Bescheinigung attestiert (im Erläuterungstext als „Muster 1“ bezeichnet).",
   "source": {
    "artifact": "erlaeuterungen",
    "locator": "Muster 20, Einleitung, S. 64–65"
   }
  },
  {
   "id": "m20.zusammenarbeit",
   "text": "Die stufenweise Wiedereingliederung soll in vertrauensvoller Zusammenarbeit von Versichertem, behandelndem Arzt, Arbeitnehmervertretung, Arbeitgeber, Betriebsarzt, Krankenkasse und ggf. MD sowie Rehabilitationsträger erfolgen.",
   "source": {
    "artifact": "erlaeuterungen",
    "locator": "Muster 20, Einleitung, S. 65"
   }
  },
  {
   "id": "m20.grundlage",
   "text": "Grundlage der Beurteilung sind die Empfehlungen zur Umsetzung der stufenweisen Wiedereingliederung in der Anlage der AU-Richtlinie des G-BA.",
   "source": {
    "artifact": "erlaeuterungen",
    "locator": "Muster 20, Einleitung, S. 65"
   }
  },
  {
   "id": "m20.aenderungen",
   "text": "Ergeben sich Änderungen am vereinbarten Ablauf, sind die Beteiligten unverzüglich zu informieren; ggf. ist ein neuer Wiedereingliederungsplan zu erstellen.",
   "source": {
    "artifact": "erlaeuterungen",
    "locator": "Muster 20, ❷, S. 65"
   }
  },
  {
   "id": "m20.ebm",
   "text": "Für die Erstellung des ärztlichen Wiedereingliederungsplanes ist die Nr. 01622 EBM berechnungsfähig (Aufdruck auf dem Vordruck).",
   "source": {
    "artifact": "mustersammlung",
    "locator": "PDF-Seite 36, Muster 20a (1.2019)"
   }
  }
 ],
