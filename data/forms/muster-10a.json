 "title": "Anforderungsschein für Laboratoriumsuntersuchungen bei Laborgemeinschaften",
 "form_version": "10.2020",
 "released": "2020-05-06",
 "status": "entwurf",
 "paper": {
  "format": "DIN A5 quer",
  "width": 595.3,
  "height": 419.5,
  "tint": "ohne"
 },
 "copies": [
  {
   "id": "10A",
   "label": "Anforderungsschein",
   "recipient": "Laborgemeinschaft (mit dem Untersuchungsmaterial)"
  }
 ],
 "notes": [
  {
   "id": "m10a.egk_voraussetzung",
   "text": "Der Anforderungsschein darf nur ausgestellt werden, wenn dem anfordernden Vertragsarzt im Quartal eine gültige elektronische Gesundheitskarte vorgelegt wurde. Ausnahmen sind z. B. bei Dringlichkeit oder zweifelsfrei bekannter Kassenzugehörigkeit zulässig.",
   "source": {
    "artifact": "erlaeuterungen",
    "locator": "Muster 10A, Einleitung, S. 40"
   }
  },
  {
   "id": "m10a.zwei_teile",
   "text": "Der Vordruck hat einen oberen Identifikationsteil und einen unteren Auftragsteil; beide Teile sind vom anfordernden Arzt auszufüllen.",
   "source": {
    "artifact": "erlaeuterungen",
    "locator": "Muster 10A, Einleitung, S. 40"
   }
  },
  {
   "id": "m10a.barcode",
   "text": "Bei Blankoformularbedruckung wird ein zweidimensionaler Barcode PDF 417 aufgedruckt (Laser- oder Tintenstrahldrucker; Tintenstrahl nach Anlage 2a BMV-Ä Nr. 1.1.3). Er enthält alle Formularinformationen und kann automatisch ausgewertet werden.",
   "source": {
    "artifact": "erlaeuterungen",
    "locator": "Muster 10A, ❿, S. 41"
   }
  },
  {
   "id": "m10a.arbeitsunfall",
   "text": "Bei Arbeitsunfällen, Berufskrankheiten und Schülerunfällen dürfen nur e01, Muster 4 und Muster 16 verwendet werden.",
   "source": {
    "artifact": "erlaeuterungen",
    "locator": "Allgemeines Nr. 9, S. 7"
   }
  },
  {
   "id": "m10a.unterschrift",
   "text": "Erst vollständig ausfüllen, dann unterschreiben – nie blanko.",
   "source": {
    "artifact": "erlaeuterungen",
    "locator": "Allgemeines Nr. 2 und Nr. 5, S. 5"
   }
  }
 ],
 "groups": [
  {
   "id": "art",
   "label": "Leistungsart",
   "select": "genau_eins",
   "rule": {
    "id": "m10a.leistungsart",
    "text": "Zu kennzeichnen ist, ob der Auftrag kurativ, präventiv oder bei belegärztlicher Behandlung erfolgt.",
    "source": {
     "artifact": "erlaeuterungen",
     "locator": "Muster 10A, ❶, S. 40"
    }
   }
  },
  {
   "id": "untersuchungen",
   "label": "Auftragsfeld: Untersuchungen",
   "select": "beliebig",
   "rule": {
    "id": "m10a.auftragsfeld",
    "text": "Der anfordernde Arzt vermerkt die Auftragsleistungen manuell durch Striche im Auftragsfeld; nicht benannte Leistungen des Allgemeinlabors unter „Sonstiges“. Die Laborgemeinschaft darf nur die angekreuzten Untersuchungen durchführen.",
    "source": {
     "artifact": "erlaeuterungen",
     "locator": "Muster 10A, ❾, S. 41"
    }
   }
  }
 ],
