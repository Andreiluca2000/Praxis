  "tint": "ohne"
 },
 "pages": [
  "Vorderseite",
  "Rückseite"
 ],
 "copies": [
  {
   "id": "8A",
   "label": "Verordnung von vergrößernden Sehhilfen",
   "recipient": "Leistungserbringer (Abgabe der Sehhilfe); Entscheidung der Krankenkasse auf der Rückseite"
  }
 ],
 "notes": [
  {
   "id": "m08a.augenarzt",
   "text": "Verordnung nur aufgrund augenärztlicher Untersuchung und nur durch Vertragsärzte, die Notwendigkeit und Art selbst bestimmen können; Optiker dürfen nicht beauftragt werden. Der Augenarzt prüft vor der Verordnung, ob der Versicherte das Hilfsmittel zielführend nutzen kann.",
   "source": {
    "artifact": "erlaeuterungen",
    "locator": "Muster 8A, Einleitung, S. 31"
   }
  },
  {
   "id": "m08a.therapeutisch",
   "text": "Eine therapeutische Sehhilfe ist verordnungsfähig, wenn sie der Behandlung von Augenverletzungen oder -erkrankungen dient, die als zugelassene Indikationen in den Hilfsmittelrichtlinien (Punkt 60) aufgeführt sind.",
   "source": {
    "artifact": "erlaeuterungen",
    "locator": "Muster 8A, Nr. 3, S. 31"
   }
  },
  {
   "id": "m08a.folgeversorgung",
   "text": "Ab 14 Jahren besteht ein erneuter Anspruch auf Sehhilfen zur Verbesserung der Sehschärfe nur bei Änderung der Sehfähigkeit um mindestens 0,5 Dioptrien; bei Kurzsichtigkeit auch bei Verbesserung um mindestens 20 Prozentpunkte. Bei therapeutischen Sehhilfen ergibt sich die Wiederversorgung aus Verlauf bzw. Behandlungskonzept.",
   "source": {
    "artifact": "erlaeuterungen",
    "locator": "Muster 8A, Nr. 4, S. 31"
   }
  },
  {
   "id": "m08a.nicht_praxis",
   "text": "Nicht von der Praxis auszufüllen: IK des Leistungserbringers, Kostenrechnung des Leistungserbringers, Entscheidung der Krankenkasse, Empfangsbestätigung und Bescheinigung des Leistungserbringers (Rückseite).",
   "source": {
    "artifact": "mustersammlung",
    "locator": "PDF-Seiten 15–16, Muster 8A (10.2014)"
   }
  },
  {
   "id": "m08a.hinweis",
   "text": "Aufdruck für den Versicherten: Die Verordnung ist kein Gutschein für einen bestimmten Betrag; die Lieferung anderer Ware anstelle der verordneten vergrößernden Sehhilfen ist nicht gestattet.",
   "source": {
    "artifact": "mustersammlung",
    "locator": "PDF-Seite 16, Muster 8A (10.2014)"
   }
  }
 ],
 "groups": [
  {
   "id": "versorgung",
   "label": "Erst- oder Folgeversorgung",
   "select": "genau_eins",
   "rule": {
    "id": "m08a.ankreuzen",
    "text": "Anzukreuzen sind: Erst- oder Folgeversorgung, die festgestellte Änderung im Hinblick auf die genannten Grenzen und ob eine Sehbeeinträchtigung mindestens WHO-Stufe 1 vorliegt. Bei Kindern und Jugendlichen bis 18 und bei therapeutischen Sehhilfen sind dazu keine Angaben nötig.",
    "source": {
     "artifact": "erlaeuterungen",
     "locator": "Muster 8A, Nr. 5, S. 31–32"
    }
   }
  },
  {
   "id": "visus_sehhilfe",
   "label": "Fernvisus bestimmt mit (Brille und/oder Kontaktlinse)",
   "select": "beliebig",
   "rule": {
    "id": "m08a.visus_vergroesserung",
    "text": "Bei vergrößernden Sehhilfen sind der bestkorrigierte Fernvisus für rechtes und linkes Auge unter Angabe der verwendeten Sehhilfe (Brille und/oder Kontaktlinse) sowie der benötigte Vergrößerungsbedarf anzugeben.",
    "source": {
     "artifact": "erlaeuterungen",
     "locator": "Muster 8A, Nr. 2, S. 31"
    }
   }
  },
  {
   "id": "erklaerung",
   "label": "Erklärung des Versicherten (bei Erstversorgung oder Verlust der Sehhilfe)",
   "select": "beliebig",
   "rule": {
    "id": "m08a.erklaerung",
    "text": "Bei Erstversorgung oder Verlust der Sehhilfe erklärt der Versicherte, dass er bisher noch keine Sehhilfe gehabt hat bzw. dass seine bisherige Sehhilfe verlorengegangen ist.",
    "source": {
     "artifact": "mustersammlung",
     "locator": "PDF-Seite 16, Muster 8A (10.2014)"
    }
   }
  }
 ],
