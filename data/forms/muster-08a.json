 "muster": "8A",
 "title": "Verordnung von vergrößernden Sehhilfen",
 "form_version": "10.2014",
 "released": "2014-09-01",
 "status": "entwurf",
 "paper": {
  "format": "DIN A5 hoch, Vorder- und Rückseite",
