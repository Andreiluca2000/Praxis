  {
   "id": "11",
   "label": "Bericht",
   "recipient": "Medizinischer Dienst (in der Regel über den zum MD bestellten Versicherten)"
  }
 ],
 "notes": [
  {
   "id": "m11.zweck",
   "text": "Für die Begutachtung durch den Medizinischen Dienst bzw. die Beurteilung, ob eine Vorstellung beim MD angebracht ist, erteilt der Vertragsarzt die erforderlichen Auskünfte auf dem Vordruck Muster 11.",
   "source": {
    "artifact": "erlaeuterungen",
    "locator": "Muster 11, Nr. 1, S. 42"
   }
  },
  {
   "id": "m11.beurteilung",
   "text": "In der Regel ist von der Beurteilung des Krankheitszustands an diesem Tag auszugehen und deren Ergebnis zu vermerken.",
   "source": {
    "artifact": "erlaeuterungen",
    "locator": "Muster 11, Nr. 3, S. 42"
   }
  },
  {
   "id": "m11.uebergabe",
   "text": "In der Regel gibt der Arzt den Bericht dem zum MD bestellten Versicherten mit. Bei Postversand im Ausnahmefall kann er das Porto abrechnen, sofern die Kasse keinen Freiumschlag zur Verfügung gestellt hat.",
   "source": {
    "artifact": "erlaeuterungen",
    "locator": "Muster 11, Nr. 5, S. 42"
   }
  },
  {
   "id": "m11.meinungsverschiedenheit",
   "text": "Bei Meinungsverschiedenheiten mit dem MD über Arbeitsunfähigkeit o. Ä. unterrichtet der Vertragsarzt die Krankenkasse schriftlich unter Darlegung seiner Gründe und kann ein Zweitgutachten beantragen. Bei AU-Bescheinigung durch einen Gebietsarzt soll ein Arzt dieses Gebiets das Zweitgutachten erstellen.",
   "source": {
    "artifact": "erlaeuterungen",
    "locator": "Muster 11, Nr. 7, S. 42"
   }
  },
  {
   "id": "m11.nicht_ausfuellen",
   "text": "Der Vordruck ist nicht auszufüllen, wenn die Arbeitsunfähigkeit spätestens am Tag der Begutachtung durch den Medizinischen Dienst beendet ist (Hinweis auf dem Vordruck).",
   "source": {
    "artifact": "mustersammlung",
    "locator": "PDF-Seite 22, Muster 11 (1.2015)"
   }
  },
  {
   "id": "m11.ebm_01621",
   "text": "Für den Bericht des Arztes ist die Nr. 01621 EBM berechnungsfähig (Hinweis auf dem Vordruck).",
   "source": {
    "artifact": "mustersammlung",
    "locator": "PDF-Seite 22, Muster 11 (1.2015)"
   }
  }
 ],
