{
  "schema_version": "1.0.0",
  "id": "muster-10",
  "muster": "10",
  "title": "Überweisungsschein für in-vitro-diagnostische Auftragsleistungen",
  "form_version": "4.2024",
  "released": "2023-11-15",
  "status": "entwurf",
  "paper": { "format": "DIN A5 quer", "width": 595.3, "height": 419.5, "tint": "ohne" },
  "copies": [
    { "id": "10", "label": "Überweisungsschein Labor", "recipient": "Labor (mit dem Untersuchungsmaterial)" }
  ],
  "notes": [
    { "id": "m10.zweck", "text": "Für in-vitro-diagnostische Leistungen (Kapitel 11, 19, 32 EBM) und Laborleistungen der Abschnitte 1.7, 8.5, 8.6, 30.12.2 ist Muster 10 und nicht Muster 6 zu verwenden; Zervixkarzinom-Früherkennung nach oKFE-RL über Muster 39.", "source": { "artifact": "erlaeuterungen", "locator": "Muster 10, Einleitung, S. 36" } },
    { "id": "m10.egk", "text": "Nur ausstellen, wenn im Quartal eine gültige eGK vorlag; Ausnahme z. B. bei dringend erforderlichen Maßnahmen oder zweifelsfrei bekannter Kassenzugehörigkeit.", "source": { "artifact": "erlaeuterungen", "locator": "Muster 10, Einleitung, S. 36" } },
    { "id": "m10.teile", "text": "Oberer Teil dient der Identifikation, unterer Teil ist der Auftragsteil; beide füllt der überweisende Arzt aus.", "source": { "artifact": "erlaeuterungen", "locator": "Muster 10, Einleitung, S. 36" } },
    { "id": "m10.arbeitsunfall", "text": "Nicht zu verwenden bei Arbeitsunfällen, Berufskrankheiten und Schülerunfällen.", "source": { "artifact": "mustersammlung", "locator": "PDF-Seite 20, Muster 10 (4.2024), Fußzeile" } },
    { "id": "m10.unterschrift", "text": "Erst vollständig ausfüllen, dann mit Vertragsarztstempel persönlich unterschreiben – nie blanko, nicht mit roter Farbe.", "source": { "artifact": "erlaeuterungen", "locator": "Allgemeines Nr. 2 und Nr. 5, S. 5" } }
  ],
  "groups": [
    { "id": "art", "label": "Leistungsart", "select": "genau_eins", "rule": { "id": "m10.art", "text": "Zu kennzeichnen ist, ob der Auftrag kurativ, präventiv, bei Empfängnisregelung/Sterilisation/Schwangerschaftsabbruch oder bei belegärztlicher Behandlung erfolgt.", "source": { "artifact": "erlaeuterungen", "locator": "Muster 10, ❶, S. 36" } } },
    { "id": "uebermittlung", "label": "Eilige Befundübermittlung", "select": "beliebig", "rule": { "id": "m10.eilt", "text": "Bei eiliger Befundübermittlung kennzeichnen und angeben, ob per Telefon oder Fax und an welche Nummer.", "source": { "artifact": "erlaeuterungen", "locator": "Muster 10, ⓮, S. 38" } } }
  ],
  "fields": [
    { "id": "personalien", "label": "Personalienfeld (Kasse, Name, geb. am, Kostenträgerkennung, Versicherten-Nr., Status, BSNR, LANR, Datum)", "kind": "personalien", "filled_by": "duria", "box": { "x": 4.3, "y": 3.4, "w": 38.0, "h": 31.7 },
      "rules": [ { "id": "m10.personalien", "text": "Die Daten der eGK werden maschinell über Kartenterminal und Praxis-EDV übertragen; BSNR und LANR nur als Ziffern.", "source": { "artifact": "erlaeuterungen", "locator": "Allgemeines Nr. 5 und Nr. 6, S. 5" } } ] },
    { "id": "kurativ", "label": "Kurativ", "kind": "checkbox", "filled_by": "praxis", "group": "art", "marker": "❶", "box": { "x": 44.2, "y": 11.5, "w": 2.3, "h": 3.5 }, "rules": [] },
    { "id": "praeventiv", "label": "Präventiv", "kind": "checkbox", "filled_by": "praxis", "group": "art", "marker": "❶", "box": { "x": 52.7, "y": 11.5, "w": 2.3, "h": 3.5 },
      "rules": [ { "id": "m10.praeventiv", "text": "„Präventiv“ bei Leistungen nach Gesundheitsuntersuchungs-, Kinder-, Mutterschafts-, KFE- und oKFE-Richtlinie sowie PrEP (§ 20j SGB V) und MRSA-Diagnostik (§ 87 Abs. 2a SGB V).", "source": { "artifact": "erlaeuterungen", "locator": "Muster 10, ❶, S. 37" } } ] },
    { "id": "belegaerztlich", "label": "bei belegärztl. Behandlung", "kind": "checkbox", "filled_by": "praxis", "group": "art", "marker": "❶", "box": { "x": 63.6, "y": 11.5, "w": 2.3, "h": 3.5 }, "rules": [] },
    { "id": "unfall", "label": "Unfall, Unfallfolgen", "kind": "checkbox", "filled_by": "praxis", "marker": "❷", "box": { "x": 76.9, "y": 11.5, "w": 2.3, "h": 3.5 },
      "rules": [ { "id": "m10.unfall", "text": "Ankreuzen, wenn die Behandlung aufgrund oder als Folge eines Unfalls erforderlich ist, damit die Kasse Kosten bei Dritten geltend machen kann.", "source": { "artifact": "erlaeuterungen", "locator": "Muster 10, ❷, S. 37" } } ] },
    { "id": "knappschaft", "label": "Knappschaftskennziffer", "kind": "text", "filled_by": "praxis", "marker": "❺", "box": { "x": 72.1, "y": 20.1, "w": 12.0, "h": 3.5 },
      "rules": [ { "id": "m10.knappschaft", "text": "Nur Knappschaftsärzte tragen bei Knappschaftsversicherten die Ziffer 87777 ein.", "source": { "artifact": "erlaeuterungen", "locator": "Muster 10, ❺, S. 37" } } ] },
    { "id": "quartal", "label": "Quartal", "kind": "quarter", "filled_by": "praxis", "format": "QJJ", "marker": "❻", "box": { "x": 89.0, "y": 20.1, "w": 7.2, "h": 3.5 },
      "rules": [ { "id": "m10.quartal", "text": "Quartal der Ausstellung in der Form QJJ; der Schein gilt auch im Folgequartal.", "source": { "artifact": "erlaeuterungen", "locator": "Muster 10, ❻, S. 37" } } ] },
    { "id": "auftragsnummer", "label": "Auftragsnummer des Labors", "kind": "text", "filled_by": "leistungserbringer", "marker": "❹", "box": { "x": 44.3, "y": 18.3, "w": 25.5, "h": 17.0 },
      "rules": [ { "id": "m10.auftragsnummer", "text": "Das Feld „Auftragsnummer des Labors“ kann das Labor für eigene Zwecke nutzen.", "source": { "artifact": "erlaeuterungen", "locator": "Muster 10, ❹, S. 37" } } ] },
    { "id": "geschlecht", "label": "Geschlecht", "kind": "letter", "filled_by": "duria", "marker": "❼", "box": { "x": 93.9, "y": 25.8, "w": 2.3, "h": 3.5 },
      "rules": [ { "id": "m10.geschlecht", "text": "Ein Buchstabe (D, M, W, X), ausgelesen von der eGK.", "source": { "artifact": "erlaeuterungen", "locator": "Muster 10, ❼, S. 37" } } ] },
    { "id": "kontrolle", "label": "Kontrolluntersuchung bekannte Infektion", "kind": "checkbox", "filled_by": "praxis", "marker": "❽", "box": { "x": 72.1, "y": 25.8, "w": 2.3, "h": 3.5 },
      "rules": [ { "id": "m10.kontrolle", "text": "Bei Erregernachweis als Kontrolle einer bereits bekannten Infektion ankreuzen und den Sachverhalt unter „Befund/Medikation“ erläutern.", "source": { "artifact": "erlaeuterungen", "locator": "Muster 10, ❽, S. 37" } } ] },
    { "id": "ser", "label": "SER", "kind": "checkbox", "filled_by": "praxis", "marker": "❾", "box": { "x": 72.1, "y": 34.4, "w": 2.3, "h": 3.5 },
      "rules": [ { "id": "m10.ser", "text": "Nur bei behördlich anerkannter Schädigungsfolge nach SER (bisher BVG u. a.); der Patient legt den Nachweis vor.", "source": { "artifact": "erlaeuterungen", "locator": "Allgemeines Nr. 8, S. 6; Muster 10, ❾, S. 38" } } ] },
    { "id": "par16", "label": "eingeschränkter Leistungsanspruch gemäß § 16 Abs. 3a SGB V", "kind": "checkbox", "filled_by": "praxis", "marker": "❿", "box": { "x": 84.1, "y": 34.4, "w": 2.3, "h": 3.5 },
      "rules": [ { "id": "m10.par16", "text": "Bei vorgelegtem Muster 85 nur Überweisungen bei akuten Erkrankungen, Schmerzzuständen, Schwangerschaft und Mutterschaft; dann dieses Feld ankreuzen.", "source": { "artifact": "erlaeuterungen", "locator": "Muster 10, ❿, S. 38" } } ] },
    { "id": "erst_bsnr", "label": "Betriebsstätten-Nr. des Erstveranlassers", "kind": "text", "filled_by": "praxis", "marker": "⓭", "box": { "x": 5.0, "y": 40.1, "w": 16.2, "h": 3.5 },
      "rules": [ { "id": "m10.weiterueberweisung", "text": "Nur bei Weiterüberweisung durch das ausführende Labor: BSNR und LANR des Erstveranlassers übernehmen (vorhandene Angaben unverändert).", "source": { "artifact": "erlaeuterungen", "locator": "Muster 10, ⓭, S. 38" } } ] },
    { "id": "erst_lanr", "label": "Arzt-Nr. des Erstveranlassers", "kind": "text", "filled_by": "praxis", "marker": "⓭", "box": { "x": 25.5, "y": 40.1, "w": 16.2, "h": 3.5 }, "rules": [] },
    { "id": "abnahmedatum", "label": "Abnahmedatum", "kind": "date", "filled_by": "praxis", "format": "TTMMJJ", "marker": "⓫", "box": { "x": 44.3, "y": 40.1, "w": 14.4, "h": 3.5 },
      "rules": [ { "id": "m10.abnahmedatum", "text": "Datum der Materialentnahme (TTMMJJ), wenn es vom Ausstellungsdatum abweicht.", "source": { "artifact": "erlaeuterungen", "locator": "Muster 10, ⓫, S. 38" } } ] },
    { "id": "abnahmezeit", "label": "Abnahmezeit", "kind": "date", "filled_by": "praxis", "format": "hhmm", "marker": "⓬", "box": { "x": 60.0, "y": 40.1, "w": 9.5, "h": 3.5 },
      "rules": [ { "id": "m10.abnahmezeit", "text": "Abnahmezeit (hhmm), falls für die Befundung erforderlich.", "source": { "artifact": "erlaeuterungen", "locator": "Muster 10, ⓬, S. 38" } } ] },
    { "id": "empfaengnis", "label": "Empfängnisregelung, Sterilisation, Schwangerschaftsabbruch", "kind": "checkbox", "filled_by": "praxis", "group": "art", "marker": "❶", "box": { "x": 72.1, "y": 40.1, "w": 2.3, "h": 3.5 }, "rules": [] },
    { "id": "eilt", "label": "Befund eilt", "kind": "checkbox", "filled_by": "praxis", "group": "uebermittlung", "marker": "⓮", "box": { "x": 5.6, "y": 45.9, "w": 2.3, "h": 3.4 }, "rules": [] },
    { "id": "telefon", "label": "Übermittlung an Telefon", "kind": "checkbox", "filled_by": "praxis", "group": "uebermittlung", "marker": "⓮", "box": { "x": 21.9, "y": 45.9, "w": 2.3, "h": 3.5 }, "rules": [] },
    { "id": "fax", "label": "Übermittlung an Fax", "kind": "checkbox", "filled_by": "praxis", "group": "uebermittlung", "marker": "⓮", "box": { "x": 30.3, "y": 45.9, "w": 2.3, "h": 3.5 }, "rules": [] },
    { "id": "nr", "label": "Nr. (Telefon/Fax)", "kind": "text", "filled_by": "praxis", "marker": "⓮", "box": { "x": 38.8, "y": 45.9, "w": 19.6, "h": 3.5 }, "rules": [] },
    { "id": "ssw", "label": "SSW", "kind": "number", "filled_by": "praxis", "marker": "❸", "box": { "x": 64.8, "y": 45.8, "w": 4.7, "h": 3.5 },
      "rules": [ { "id": "m10.ssw", "text": "Bei bestehender Schwangerschaft die Schwangerschaftswoche eintragen.", "source": { "artifact": "erlaeuterungen", "locator": "Muster 10, ❸, S. 37" } } ] },
    { "id": "diagnose", "label": "Diagnose/Verdachtsdiagnose", "kind": "text", "filled_by": "arzt", "marker": "⓯", "lines": 1, "box": { "x": 4.3, "y": 51.6, "w": 65.5, "h": 7.6 },
      "rules": [ { "id": "m10.diagnose", "text": "Diagnose bzw. Verdachtsdiagnose, möglichst als ICD-Code.", "source": { "artifact": "erlaeuterungen", "locator": "Muster 10, ⓯, S. 38" } } ] },
    { "id": "befund", "label": "Befund/Medikation", "kind": "text", "filled_by": "arzt", "marker": "⓯", "lines": 2, "box": { "x": 4.3, "y": 60.1, "w": 65.5, "h": 13.0 },
      "rules": [ { "id": "m10.befund", "text": "Befund bzw. Medikation angeben; bei Kontrolluntersuchung einer bekannten Infektion hier den Sachverhalt erläutern.", "source": { "artifact": "erlaeuterungen", "locator": "Muster 10, ❽ und ⓯, S. 37–38" } } ] },
    { "id": "auftrag", "label": "Auftrag", "kind": "text", "filled_by": "praxis", "marker": "⓯", "lines": 3, "box": { "x": 4.3, "y": 74.4, "w": 65.5, "h": 18.8 },
