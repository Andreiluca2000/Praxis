 "notes": [
  {
   "id": "m27.abstimmung",
   "text": "Der Betreuungsplan ist Ergebnis eines Abstimmungsprozesses zwischen verordnendem Arzt, soziotherapeutischem Leistungserbringer und Patient und Basis der Therapie; Verlauf und Ziele werden regelmäßig beraten und der Plan ggf. angepasst.",
   "source": {
    "artifact": "erlaeuterungen",
    "locator": "Muster 27, Einleitung, S. 76"
   }
  },
  {
   "id": "m27.vorlage",
   "text": "Der Plan muss zusammen mit dem ausgefüllten Muster 26 spätestens am 3. Arbeitstag nach Ausstellung der Verordnung der Krankenkasse zur Genehmigung vorgelegt werden.",
   "source": {
    "artifact": "erlaeuterungen",
    "locator": "Muster 27, Einleitung, S. 76"
   }
  },
  {
   "id": "m27.kostenuebernahme",
   "text": "Bis zur Entscheidung über die Genehmigung übernimmt die Krankenkasse die Kosten der verordneten und erbrachten Leistungen.",
   "source": {
    "artifact": "erlaeuterungen",
    "locator": "Muster 27, Einleitung, S. 76"
   }
  },
  {
   "id": "m27.st_rl",
   "text": "Die Soziotherapie-Richtlinie des G-BA (ST-RL) ist zu beachten; zwei Durchschläge (Original Krankenkasse, 1. Leistungserbringer, 2. Arzt).",
   "source": {
    "artifact": "erlaeuterungen",
    "locator": "Muster 27, Einleitung, S. 76"
   }
  }
 ],
