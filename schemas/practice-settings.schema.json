{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:praxis-assistent:schema:practice-settings:0.1.0",
  "title": "Praxisassistenz non-patient settings",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "region", "available_billing_systems", "hzv", "analysis", "safety"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "region": {"type": "object", "additionalProperties": false, "required": ["country", "bundesland", "kv"], "properties": {
      "country": {"const": "DE"},
      "bundesland": {"const": "NRW"},
      "kv": {"enum": [null, "Nordrhein", "Westfalen-Lippe"]}
    }},
    "available_billing_systems": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["EBM", "GOAE"]}},
    "hzv": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "contracts"],
      "properties": {
        "enabled": {"type": "boolean"},
        "contracts": {"type": "array", "items": {"$ref": "#/$defs/hzv_contract"}}
      }
    },
    "analysis": {"type": "object", "additionalProperties": false, "required": ["default_scope", "unknown_condition_policy", "date_basis"], "properties": {
      "default_scope": {"enum": ["selected_date", "date_range", "quarter", "whole_record"]},
      "unknown_condition_policy": {"const": "not_verifiable"},
      "date_basis": {"const": "service_date"}
    }},
    "safety": {"type": "object", "additionalProperties": false, "required": ["auto_submit_billing", "auto_write_to_duria", "require_patient_context_recheck", "allow_patient_data_in_project_files"], "properties": {
      "auto_submit_billing": {"const": false},
      "auto_write_to_duria": {"const": false},
      "require_patient_context_recheck": {"const": true},
      "allow_patient_data_in_project_files": {"const": false}
    }}
  },
  "$defs": {
    "hzv_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_id", "name", "version", "kv", "insurer_ids", "valid_from", "valid_to", "source_uri", "terms_review_status", "practice_participation"],
      "properties": {
        "contract_id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "kv": {"enum": ["Nordrhein", "Westfalen-Lippe"]},
        "insurer_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "valid_from": {"type": "string", "format": "date"},
        "valid_to": {"type": ["string", "null"], "format": "date"},
        "source_uri": {"type": "string", "format": "uri"},
        "terms_review_status": {"enum": ["pending", "approved", "rejected"]},
        "practice_participation": {
          "type": "object", "additionalProperties": false,
          "required": ["status", "valid_from", "valid_to", "evidence_ref"],
          "properties": {
            "status": {"enum": ["unknown", "confirmed", "not_participating"]},
            "valid_from": {"type": ["string", "null"], "format": "date"},
            "valid_to": {"type": ["string", "null"], "format": "date"},
            "evidence_ref": {"type": ["string", "null"]}
          },
          "allOf": [{"if": {"properties": {"status": {"const": "confirmed"}}}, "then": {"properties": {
            "valid_from": {"type": "string", "format": "date"},
            "evidence_ref": {"type": "string", "minLength": 1}
          }}}]
        }
      }
    }
  }
}
