{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:praxis-assistent:schema:forms-catalog:1.0.0",
  "title": "Katalog aller KBV-Vordrucke mit Ausfüllregeln (Erläuterungen zur Vordruckvereinbarung)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "source", "note", "entries"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "status": { "enum": ["entwurf", "geprueft"] },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "stand", "stand_vordrucke"],
      "properties": {
        "artifact": { "const": "erlaeuterungen" },
        "stand": { "type": "string" },
        "stand_vordrucke": { "type": "string" }
      }
    },
    "note": { "type": "string" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["muster", "title", "stand", "status", "erlaeuterungen_pages", "copies", "purpose", "keywords", "use_instead", "rules"],
        "properties": {
          "muster": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "stand": { "type": ["string", "null"], "pattern": "^[0-9]{1,2}\\.[0-9]{4}$" },
          "status": { "enum": ["aktiv", "unbesetzt"] },
          "erlaeuterungen_pages": { "type": "string", "pattern": "^[0-9]+(–[0-9]+)?$" },
          "copies": { "type": "array", "items": { "type": "string" } },
          "purpose": { "type": ["string", "null"] },
          "keywords": { "type": "array", "items": { "type": "string", "pattern": "^[^A-ZÄÖÜ]+$" } },
          "use_instead": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["when", "muster", "locator"],
              "properties": { "when": { "type": "string" }, "muster": { "type": "string" }, "locator": { "type": "string" } }
            }
          },
          "rules": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "kind", "text", "locator"],
              "properties": {
                "id": { "type": "string", "pattern": "^m[0-9a-z]+\\.[a-z0-9_.]+$" },
                "kind": { "enum": ["voraussetzung", "ausfuellen", "nicht_verwenden", "frist", "nachweis", "genehmigung", "hinweis"] },
                "text": { "type": "string", "minLength": 1 },
                "locator": { "type": "string", "pattern": "S\\. [0-9]+" }
              }
            }
          }
        }
      }
    }
  }
}
