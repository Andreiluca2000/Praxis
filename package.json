{
  "name": "praxis-assistent",
  "version": "0.1.0",
  "private": true,
  "description": "Interner Assistent für eine Hausarztpraxis: ICD-10-GM-Suche und erklärbare Abrechnungsprüfung (MVP, nur synthetische Daten).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "validate:data": "tsx src/cli/validate-data.ts",
    "ui:dev": "vite",
    "ui:build": "vite build",
    "dev": "tauri dev",
    "build": "tauri build",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "check": "pnpm typecheck && pnpm test && pnpm validate:data"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "lucide-react": "^1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
